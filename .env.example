# Optional overrides only. `docker compose up -d --build` works without this file.
# Sensor binds to loopback for safe initial setup. After host firewall verification,
# change SSH_BIND to 0.0.0.0 and recreate the sensor to expose it.
SSH_BIND=127.0.0.1
SSH_PORT=22
WEB_BIND=127.0.0.1
WEB_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
# Enable with HTTPS reverse proxy only. HTTP localhost needs false.
COOKIE_SECURE=false
# Explicit project requirement: store attacker passwords in clear text.
LOG_PASSWORDS=true
RETENTION_DAYS=30
MAX_CONNECTIONS=64
SESSION_SECONDS=300
MAX_COMMANDS=200
SPOOL_BYTES=268435456
# Oldest events are removed on reaching either dashboard quota, even before TTL.
MAX_DB_EVENTS=100000
MAX_EVENT_STORAGE_BYTES=67108864
# SQLite main-file safety limit; WAL/backup space is additional.
MAX_DB_BYTES=268435456
MAX_SPOOL_FILES=4096
SENSOR_SUBNET=172.30.222.0/24
WEB_SUBNET=172.30.223.0/24
