# One-shot Docker Desktop VM firewall tool. Never runs as a honeypot service.
FROM python:3.15.2-slim-trixie@sha256:e97b88e416c3c01eb427b21fd8cd3ebf006e6ee38afcfcc3cae1c54ee2ab0a75
RUN apt-get update \
    && apt-get install --no-install-recommends -y iptables \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/firewall.sh /usr/local/sbin/ssh-sentinel-firewall
ENTRYPOINT ["/bin/sh", "/usr/local/sbin/ssh-sentinel-firewall"]
